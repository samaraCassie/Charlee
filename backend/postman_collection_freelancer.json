{
  "info": {
    "name": "Charlee - Freelancer System API",
    "description": "Complete API collection for testing the Freelancer Management System\n\n**Features:**\n- 7 AI Agents (Collector, Analyzer, Evaluator, Negotiator, Auto-learning, Analytics, Branding)\n- 5 MVP Requirements (RN09-RN13)\n- 3 Learning Components (PricingLearner, RejectionPatternLearner, HourlyRateOptimizer)\n\n**Setup:**\n1. Import this collection into Postman\n2. Create environment with variables: `base_url` and `token`\n3. Get JWT token from Login endpoint\n4. Start testing!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Save token to environment",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('token', jsonData.access_token);",
                  "    console.log('Token saved to environment');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@charlee.ai\",\n  \"password\": \"test123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Login to get JWT token. Token will be automatically saved to environment."
          },
          "response": []
        },
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Check if backend is running"
          },
          "response": []
        }
      ],
      "description": "Authentication endpoints"
    },
